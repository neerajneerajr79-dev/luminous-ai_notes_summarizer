{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lumio: API server (port 5000)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "lumio"
      }
    },
    {
      "label": "Lumio: Client dev server (port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "lumio"
      }
    },
    {
      "label": "Lumio: Run full app (API + Client)",
      "dependsOn": [
        "Lumio: API server (port 5000)",
        "Lumio: Client dev server (port 5173)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Lumio: Backend tests",
      "type": "shell",
      "command": "npx vitest run",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": []
    }
  ]
}
